#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run lint-staged to lint and format staged files
# This will auto-fix linting issues and format code
pnpm exec lint-staged

# Run lint check on all apps to ensure no linting errors remain
# This will fail the commit if there are any linting errors that couldn't be auto-fixed
pnpm run lint
